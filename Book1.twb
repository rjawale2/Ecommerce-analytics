      <aliases enabled='yes' />
      <column caption='Purchase Conversion' datatype='real' default-format='p0%' name='[Calculation_9477305308921856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sessions]) &gt; 0 THEN&#13;&#10;    SUM([purchase_sessions]) / SUM([sessions])&#13;&#10;END' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_9477305310097409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([valid_orders]) &gt; 0 THEN&#13;&#10;    SUM([gross_purchase_revenue_usd]) / SUM([valid_orders])&#13;&#10;END' />
      </column>
      <column caption='Revenue 7-Day Average' datatype='real' name='[Calculation_9477305313042434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INDEX() &gt;= 7 THEN&#13;&#10;    WINDOW_AVG(&#13;&#10;        SUM([gross_purchase_revenue_usd]),&#13;&#10;        -6,&#13;&#10;        0&#13;&#10;    )&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Conversion 7-Day Average' datatype='real' name='[Calculation_9477305315700739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INDEX() &gt;= 7&#13;&#10;AND WINDOW_SUM(SUM([sessions]), -6, 0) &gt; 0&#13;&#10;THEN&#13;&#10;    WINDOW_SUM(SUM([purchase_sessions]), -6, 0)&#13;&#10;    /&#13;&#10;    WINDOW_SUM(SUM([sessions]), -6, 0)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
