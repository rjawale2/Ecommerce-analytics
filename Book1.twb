      <column caption='Session-Product View' datatype='real' name='[Calculation_2518772834078720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([product_view_sessions]) / SUM([sessions])' />
      </column>
      <column caption='Product View-cart' datatype='real' name='[Calculation_2518772834234369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cart_sessions]) / SUM([product_view_sessions])' />
      </column>
      <column caption='Cart-Checkout' datatype='real' name='[Calculation_2518772834357250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_sessions]) / SUM([cart_sessions])' />
      </column>
      <column caption='Checkout-Purchase' datatype='real' name='[Calculation_2518772834451459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_purchase_sessions]) / SUM([checkout_sessions])' />
      </column>
      <column caption='Overall session-purchase' datatype='real' name='[Calculation_2518772834496516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchase_sessions]) / SUM([sessions])' />
      </column>
      <column caption='After Session Start' datatype='real' name='[Calculation_2518772836818949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_2518772834078720]' />
      </column>
      <column caption='After Product View' datatype='real' name='[Calculation_2518772836962310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_2518772834234369]' />
      </column>
      <column caption='After Add to Cart' datatype='real' name='[Calculation_2518772837429255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_2518772834357250]' />
      </column>
      <column caption='After Checkout' datatype='real' name='[Calculation_2518772837523464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_2518772834451459]' />
      </column>
      <column caption='Checkout Completion' datatype='real' default-format='p0%' name='[Calculation_9477305325903876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([checkout_sessions]) &gt; 0 THEN&#13;&#10;    SUM([checkout_purchase_sessions])&#13;&#10;    /&#13;&#10;    SUM([checkout_sessions])&#13;&#10;END' />
      </column>
      <column caption='Purchase Conversion' datatype='real' default-format='p0.00%' name='[Calculation_9477305331408901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sessions]) &gt; 0 THEN&#13;&#10;    SUM([purchase_sessions]) / SUM([sessions])&#13;&#10;END' />
      </column>
      <column caption='Potential Recovered Purchase Visits' datatype='real' name='[Calculation_9477305335316488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;    SUM([checkout_without_purchase_sessions])&#13;&#10;    * [Parameters].[Parameter 9477305334587399],&#13;&#10;    0&#13;&#10;)' />
      </column>
